---
layout: base.njk
title: "Contact Us"
description: "Get in touch with TechFun Universe for a free consultation on your website, mobile app, software, or AI project."
---
<style>
.form-group { margin-bottom: var(--space-2); }
.form-group label { display:block; font-size:0.85rem; font-weight:600; color: var(--navy-deep); margin-bottom:0.3rem; }
.form-group input, .form-group select, .form-group textarea {
  width:100%; padding:0.75rem 1rem; border:1px solid var(--border); border-radius: var(--radius-s);
  font-family: var(--font-body); font-size:0.95rem; background: var(--white); color: var(--ink);
}
.form-group input:focus, .form-group select:focus, .form-group textarea:focus { outline: 2px solid var(--orange); border-color: var(--orange); }
.contact-info-item { display:flex; gap:0.8rem; align-items:flex-start; margin-bottom: var(--space-3); }
.contact-info-icon { width:40px; height:40px; border-radius: var(--radius-s); background: rgba(255,122,0,0.12); color: var(--orange); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
</style>

<section class="hero" style="padding-bottom: var(--space-5);">
  <svg class="hero-arc" viewBox="0 0 400 400" fill="none">
    <path d="M120 20 C 260 40, 380 140, 360 260 C 345 350, 250 380, 170 360" stroke="#FF7A00" stroke-width="3" stroke-linecap="round" opacity="0.85"/>
    <circle cx="170" cy="360" r="7" fill="#FF7A00"/>
  </svg>
  <div class="container hero-inner">
    <span class="eyebrow">Contact</span>
    <h1 style="color:#fff;">Let's build something amazing</h1>
    <p class="lead">Tell us about your project. We usually respond within one business day.</p>
  </div>
</section>

<section class="section">
  <div class="container grid grid-2" style="gap: var(--space-6); align-items:flex-start;">
    <div class="card reveal-item" style="padding: var(--space-4);">
      <h3>Send us a message</h3>
      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact">
        <p style="display:none;"><label>Don't fill this out: <input name="bot-field"></label></p>
        <div class="form-group">
          <label for="name">Full Name</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div class="form-group">
          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" name="phone">
        </div>
        <div class="form-group">
          <label for="service">Service You're Interested In</label>
          <select id="service" name="service">
            <option>Website Design &amp; Development</option>
            <option>Mobile App Development</option>
            <option>Custom Software Development</option>
            <option>AI Solutions</option>
            <option>Digital Marketing</option>
            <option>Branding &amp; Graphics</option>
            <option>Not sure yet</option>
          </select>
        </div>
        <div class="form-group">
          <label for="message">Tell us about your project</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">Request a Free Consultation</button>
      </form>
    </div>

    <div>
      <div class="contact-info-item">
        <div class="contact-info-icon">📞</div>
        <div><strong style="color:var(--navy-deep);">Phone</strong><br><a href="tel:{{ contact.phone_1 | replace(' ', '') }}">{{ contact.phone_1 }}</a><br><a href="tel:{{ contact.phone_2 | replace(' ', '') }}">{{ contact.phone_2 }}</a></div>
      </div>
      <div class="contact-info-item">
        <div class="contact-info-icon">💬</div>
        <div><strong style="color:var(--navy-deep);">WhatsApp</strong><br><a href="https://wa.me/{{ contact.whatsapp | replace(' ', '') | replace('+', '') }}">{{ contact.whatsapp }}</a></div>
      </div>
      <div class="contact-info-item">
        <div class="contact-info-icon">📍</div>
        <div><strong style="color:var(--navy-deep);">Address</strong><br>{{ contact.address }}</div>
      </div>
      <div class="contact-info-item">
        <div class="contact-info-icon">🕐</div>
        <div><strong style="color:var(--navy-deep);">Hours</strong><br>{{ contact.hours }}</div>
      </div>
    </div>
  </div>
</section>
