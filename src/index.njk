<style>
  .orbit-hero {
    --oh-void: var(--navy-darker);
    --oh-deep: var(--navy-deep);
    --oh-glow: #3f6fd1;
    --oh-bright: #a9c4f5;
    --oh-orange: var(--orange);
    --oh-orange-warm: var(--orange-light);
    position: relative;
    overflow: hidden;
    min-height: 640px;
    padding: var(--space-7) 0;
    background:
      radial-gradient(ellipse 120% 80% at 50% 105%, rgba(63,111,209,0.20), transparent 60%),
      radial-gradient(ellipse 60% 50% at 78% 30%, rgba(255,122,0,0.12), transparent 65%),
      linear-gradient(180deg, var(--oh-void) 0%, var(--oh-deep) 55%, var(--navy-darker) 100%);
    color: #fff;
  }
  .oh-stars {
    position:absolute; inset:0;
    background-image:
      radial-gradient(1.5px 1.5px at 12% 20%, #fff 100%, transparent 100%),
      radial-gradient(1px 1px at 25% 65%, #fff 100%, transparent 100%),
      radial-gradient(1.5px 1.5px at 40% 15%, #fff 100%, transparent 100%),
      radial-gradient(1px 1px at 60% 80%, #fff 100%, transparent 100%),
      radial-gradient(1.5px 1.5px at 85% 25%, #fff 100%, transparent 100%),
      radial-gradient(1px 1px at 92% 60%, #fff 100%, transparent 100%),
      radial-gradient(1.5px 1.5px at 8% 85%, #fff 100%, transparent 100%),
      radial-gradient(1px 1px at 70% 10%, #fff 100%, transparent 100%),
      radial-gradient(1.5px 1.5px at 50% 92%, #fff 100%, transparent 100%);
    opacity: 0.5;
  }
  .oh-headline { position: relative; z-index: 20; max-width: 520px; }
  .oh-headline h1 { color: #f4f7ff; }
  .oh-headline h1 span {
    background: linear-gradient(100deg, var(--oh-bright), var(--oh-orange-warm) 90%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .oh-headline .lead { color: rgba(226,232,248,0.72); max-width: 420px; }

  .oh-orbit-wrap {
    position: absolute;
    top: 55%; left: 76%;
    transform: translate(-50%,-50%);
    width: 720px; height: 720px;
    z-index: 10;
  }
  .oh-ring { position:absolute; top:50%; left:50%; border-radius:50%; border:1px solid rgba(169,196,245,0.16); transform:translate(-50%,-50%); }
  .oh-ring.r1 { width:280px; height:280px; }
  .oh-ring.r2 { width:430px; height:430px; border-color: rgba(255,122,0,0.14); }
  .oh-ring.r3 { width:600px; height:600px; }

  .oh-spin { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); }
  .oh-spin.s1 { width:430px; height:430px; animation: oh-rotate 46s linear infinite; }
  .oh-spin.s2 { width:600px; height:600px; animation: oh-rotate 70s linear infinite reverse; }
  @keyframes oh-rotate { from{ transform:translate(-50%,-50%) rotate(0deg);} to{ transform:translate(-50%,-50%) rotate(360deg);} }
  .oh-counter { animation: oh-counter-rotate 46s linear infinite; }
  .oh-spin.s2 .oh-counter { animation-duration:70s; animation-direction:normal; }
  @keyframes oh-counter-rotate { from{ transform:rotate(0deg);} to{ transform:rotate(-360deg);} }

  .oh-core {
    position:absolute; top:50%; left:50%; width:150px; height:150px; transform:translate(-50%,-50%); border-radius:50%;
    background: radial-gradient(circle at 34% 30%, var(--oh-bright) 0%, var(--oh-glow) 30%, var(--oh-deep) 62%, #050a1e 88%);
    box-shadow: 0 0 60px 10px rgba(63,111,209,0.5), 0 0 130px 36px rgba(255,122,0,0.18),
      inset -14px -12px 40px rgba(0,0,0,0.55), inset 8px 6px 32px rgba(255,148,51,0.22);
    z-index:5;
  }
  .oh-core::after { content:''; position:absolute; inset:0; border-radius:50%; background: radial-gradient(circle at 68% 72%, rgba(255,122,0,0.32), transparent 55%); mix-blend-mode:screen; }
  .oh-core-pulse {
    position:absolute; top:50%; left:50%; width:150px; height:150px; transform:translate(-50%,-50%); border-radius:50%;
    box-shadow:0 0 0 0 rgba(63,111,209,0.35); animation: oh-pulse 3.2s ease-out infinite; z-index:4;
  }
  @keyframes oh-pulse { 0%{box-shadow:0 0 0 0 rgba(63,111,209,0.35);} 70%{box-shadow:0 0 0 50px rgba(63,111,209,0);} 100%{box-shadow:0 0 0 0 rgba(63,111,209,0);} }
  .oh-tilt-ring {
    position:absolute; top:50%; left:50%; width:270px; height:70px; transform:translate(-50%,-50%) rotate(-16deg);
    border-radius:50%; border:1.5px solid rgba(255,148,51,0.5); box-shadow:0 0 16px rgba(255,122,0,0.3); z-index:6; pointer-events:none;
  }
  svg.oh-links { position:absolute; inset:0; width:100%; height:100%; overflow:visible; }
  .oh-link-line { stroke:url(#ohLineGrad); stroke-width:1.2; fill:none; stroke-dasharray:4 7; animation: oh-dash 3s linear infinite; opacity:0.5; }
  @keyframes oh-dash { to{ stroke-dashoffset:-110; } }

  .oh-node {
    position:absolute; width:104px; transform:translate(-50%,-50%);
    background: linear-gradient(160deg, rgba(255,255,255,0.10), rgba(255,255,255,0.03));
    border:1px solid rgba(255,255,255,0.14); border-radius:14px; padding:10px 10px 8px; backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.15); text-align:center;
  }
  .oh-node .oh-icon { width:26px; height:26px; margin:0 auto 6px; border-radius:7px; display:flex; align-items:center; justify-content:center; font-size:13px; }
  .oh-node .oh-label { font-family: var(--font-mono); font-size:8.5px; letter-spacing:0.03em; color: rgba(226,232,248,0.85); line-height:1.3; }
  .oh-node.blue .oh-icon { background: linear-gradient(140deg, rgba(63,111,209,0.35), rgba(63,111,209,0.05)); box-shadow:0 0 14px rgba(63,111,209,0.4); }
  .oh-node.orange .oh-icon { background: linear-gradient(140deg, rgba(255,122,0,0.35), rgba(255,122,0,0.05)); box-shadow:0 0 14px rgba(255,122,0,0.4); }

  .oh-vignette { position:absolute; inset:0; background: radial-gradient(ellipse 55% 60% at 8% 30%, rgba(3,5,9,0.5), transparent 60%); z-index:15; pointer-events:none; }

  @media (prefers-reduced-motion: reduce) {
    .oh-spin, .oh-core-pulse, .oh-link-line, .oh-counter { animation:none !important; }
  }
  @media (max-width:900px) {
    .orbit-hero { min-height: 760px; }
    .oh-orbit-wrap { left:50%; top:70%; transform:translate(-50%,-50%) scale(0.62); }
    .oh-headline { max-width:none; }
  }
</style>

<section class="orbit-hero">
