      <div class="hero-cta">
        <a href="/contact/" class="btn btn-primary">Start Your Project</a>
        <a href="/portfolio/" class="btn btn-ghost">See Our Work</a>
      </div>
    </div>
  </div>

  <div class="oh-orbit-wrap">
    <div class="oh-ring r1"></div>
    <div class="oh-ring r2"></div>
    <div class="oh-ring r3"></div>

    <svg class="oh-links" viewBox="-360 -360 720 720">
      <defs>
        <linearGradient id="ohLineGrad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#3f6fd1"/>
          <stop offset="100%" stop-color="#FF7A00"/>
        </linearGradient>
      </defs>
      <line class="oh-link-line" x1="0" y1="0" x2="-208" y2="0"/>
      <line class="oh-link-line" x1="0" y1="0" x2="147" y2="147"/>
      <line class="oh-link-line" x1="0" y1="0" x2="-147" y2="147"/>
      <line class="oh-link-line" x1="0" y1="0" x2="208" y2="0"/>
      <line class="oh-link-line" x1="0" y1="0" x2="147" y2="-147"/>
      <line class="oh-link-line" x1="0" y1="0" x2="-147" y2="-147"/>
      <line class="oh-link-line" x1="0" y1="0" x2="0" y2="-208"/>
    </svg>

    <div class="oh-spin s1">
      <div class="oh-counter">
        <div class="oh-node blue" style="top:0%; left:100%;"><div class="oh-icon">🌐</div><div class="oh-label">BUSINESS<br>WEBSITE</div></div>
        <div class="oh-node orange" style="top:100%; left:22%;"><div class="oh-icon">🏫</div><div class="oh-label">SCHOOL<br>MANAGEMENT</div></div>
        <div class="oh-node blue" style="top:22%; left:0%;"><div class="oh-icon">🏗️</div><div class="oh-label">CONSTRUCTION<br>PLATFORM</div></div>
      </div>
    </div>

    <div class="oh-spin s2">
      <div class="oh-counter">
        <div class="oh-node orange" style="top:50%; left:100%;"><div class="oh-icon">🤖</div><div class="oh-label">AI<br>ASSISTANT</div></div>
        <div class="oh-node blue" style="top:100%; left:50%;"><div class="oh-icon">📱</div><div class="oh-label">MOBILE<br>APPS</div></div>
        <div class="oh-node orange" style="top:50%; left:0%;"><div class="oh-icon">☁️</div><div class="oh-label">CLOUD<br>INFRASTRUCTURE</div></div>
        <div class="oh-node blue" style="top:0%; left:50%;"><div class="oh-icon">🛒</div><div class="oh-label">E-COMMERCE<br>PLATFORMS</div></div>
      </div>
    </div>

    <div class="oh-tilt-ring"></div>
    <div class="oh-core-pulse"></div>
    <div class="oh-core"></div>
  </div>

  <div class="oh-vignette"></div>
</section>

<section class="section-dark section-snug">
  <div class="container">
    <div class="stat-strip reveal" style="border-top:none; margin-top:0; padding-top:0;">
