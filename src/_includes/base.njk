<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | TechFun Universe</title>
<meta name="description" content="{{ description or excerpt }}">
<meta property="og:title" content="{{ title }} | TechFun Universe">
<meta property="og:description" content="{{ description or excerpt }}">
<meta property="og:type" content="website">
<meta property="og:url" content="https://techfununiverse.com{{ page.url }}">
<meta property="og:image" content="https://techfununiverse.com/assets/img/og-image.jpg">
<meta property="og:site_name" content="TechFun Universe">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }} | TechFun Universe">
<meta name="twitter:description" content="{{ description or excerpt }}">
<meta name="twitter:image" content="https://techfununiverse.com/assets/img/og-image.jpg">
<link rel="icon" href="/assets/img/favicon.png">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "TechFun Universe",
  "description": "Digital agency in Monrovia, Liberia building websites, mobile apps, custom software, and AI solutions for businesses, schools, NGOs, and entrepreneurs across West Africa.",
  "url": "https://techfununiverse.com",
  "logo": "https://techfununiverse.com/assets/img/logo.png",
  "image": "https://techfununiverse.com/assets/img/og-image.jpg",
  "email": "info@techfununiverse.com",
  "telephone": "+231775478253",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Chocolate City New Junction, Gardnersville Township",
    "addressLocality": "Monrovia",
    "addressCountry": "LR"
  },
  "openingHours": "Mo-Fr 09:00-18:00",
  "sameAs": [
    "https://www.facebook.com/profile.php?id=61584697685701"
  ]
}
</script>
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>

{% include "partials/header.njk" %}

{{ content | safe }}

{% include "partials/footer.njk" %}
{% include "partials/quick-quote-modal.njk" %}

<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", (user) => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
<script src="/assets/js/main.js"></script>
</body>
</html>
