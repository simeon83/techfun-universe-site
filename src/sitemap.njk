---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
  {%- if item.url and item.data.eleventyExcludeFromCollections != true and item.url != "/admin/" and item.url != "/thank-you/" %}
  <url>
    <loc>https://techfununiverse.com{{ item.url }}</loc>
    {%- if item.date %}
    <lastmod>{{ item.date.toISOString().split('T')[0] }}</lastmod>
    {%- endif %}
  </url>
  {%- endif %}
{%- endfor %}
</urlset>
